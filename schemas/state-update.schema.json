{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-lab.local/schemas/state-update.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "profile": {
      "$ref": "profile.schema.json"
    },
    "session": {
      "$ref": "session.schema.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "review.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "expected_version"
  ],
  "additionalProperties": false
}
