{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-lab.local/schemas/completion.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "expected_version": {"type": "integer", "minimum": 0},
    "review": {"$ref": "review.schema.json"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "evidence.schema.json"}}
  },
  "required": ["schema_version", "expected_version", "review", "evidence"],
  "additionalProperties": false
}
