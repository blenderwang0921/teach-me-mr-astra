{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-lab.local/schemas/ready.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exercise_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contract_hash": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    }
  },
  "required": [
    "schema_version",
    "exercise_id",
    "revision",
    "contract_hash",
    "report_id"
  ],
  "additionalProperties": false
}
