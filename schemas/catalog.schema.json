{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-lab.local/schemas/catalog.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
      }
    }
  },
  "required": [
    "schema_version",
    "materials"
  ],
  "additionalProperties": false
}
