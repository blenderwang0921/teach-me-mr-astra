{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-lab.local/schemas/profile.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language_standard": {
      "enum": [
        20,
        23
      ]
    },
    "platform": {
      "type": "string"
    },
    "time_budget": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "preferences": {
      "type": "object"
    },
    "preferred_interaction_language": {
      "type": "string",
      "minLength": 1
    },
    "self_reported_experience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "goals",
    "language_standard",
    "platform",
    "time_budget",
    "preferences",
    "preferred_interaction_language",
    "self_reported_experience"
  ],
  "additionalProperties": false
}
