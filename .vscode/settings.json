{
  "files.exclude": {
    "**/evidence": true,
    "**/build": true,
    "**/reports": true,
    "**/.cache": true,
    "**/.instructor": true
  },
  "search.exclude": {
    "**/evidence/**": true,
    "**/build/**": true,
    "**/reports/**": true,
    "**/.cache/**": true,
    "**/.instructor/**": true
  },
  "files.readonlyInclude": {
    "**/evidence/**": true
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "ruff.path": [
    "${workspaceFolder}/.venv/bin/ruff"
  ],
  "C_Cpp.clang_format_style": "file"
}
