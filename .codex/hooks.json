{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\"; \"$repo_root/.venv/bin/python\" \"$repo_root/tools/format_code.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
